{
	"name": "react-router-starter-template",
	"version": "0.0.0",
	"description": "Cloudflare-react-router-template",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22",
		"pnpm": ">=11"
	},
	"dependencies": {
		"argon2": "0.44.0",
		"isbot": "5.2.1",
		"lodash": "4.18.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"react-router": "8.2.0",
		"react-router-dom": "^7.18.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.45.1",
		"@react-router/dev": "8.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/lodash": "4.17.24",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.1.5",
		"wrangler": "4.112.0"
	},
	"scripts": {
		"dev": "react-router dev --host",
		"preview": "pnpm run build && vite preview",
		"postinstall": "npm run typecheck",
		"build:staging": "react-router build --mode staging",
		"build:production": "react-router build --mode production",
		"cf-typegen": "wrangler types",
		"typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
		"db:migrate:staging": "wrangler d1 migrations apply name--db-staging --remote",
		"db:migrate:production": "wrangler d1 migrations apply name--db-production --remote",
		"deploy:staging": "pnpm run build:staging && wrangler deploy",
		"deploy:production": "pnpm run build:production && wrangler deploy"
	}
}